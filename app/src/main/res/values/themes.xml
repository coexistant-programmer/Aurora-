<resources>
    <!-- Base theme. Compose (AuroraTheme) supplies the real colors at runtime. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Aurora.WidgetConfig" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowMinWidthMinor">80%dp</item>
        <item name="android:windowMinWidthMajor">80%dp</item>
    </style>
</resources>
